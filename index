const buildBtn = document.getElementById('build');
const downloadBtn = document.getElementById('download');
let builtZipBlob = null;
const fill = document.getElementById('fill');
const statusEl = document.getElementById('status');
const logEl = document.getElementById('log');

function log(s) {
  logEl.textContent += s + "\n";
  logEl.scrollTop = logEl.scrollHeight;
}

const crcTable = (() => {
  const t = new Uint32Array(256);
  for (let n=0;n<256;n++) {
    let c=n;
    for (let k=0;k<8;k++) c = (c & 1) ? (0xedb88320 ^ (c >>> 1)) : (c >>> 1);
    t[n]=c>>>0;
  }
  return t;
})();

function crc32(u8) {
  let c=0xffffffff;
  for (let i=0;i<u8.length;i++) c = crcTable[(c ^ u8[i]) & 0xff] ^ (c >>> 8);
  return (c ^ 0xffffffff) >>> 0;
}

function u16(v) { return new Uint8Array([v&255,(v>>>8)&255]); }
function u32(v) { return new Uint8Array([v&255,(v>>>8)&255,(v>>>16)&255,(v>>>24)&255]); }
function concat(parts) {
  const len=parts.reduce((n,p)=>n+p.length,0), out=new Uint8Array(len);
  let o=0; for (const p of parts) { out.set(p,o); o+=p.length; }
  return out;
}
const enc = new TextEncoder();

function makeZip(files) {
  const locals=[], centrals=[];
  let offset=0;
  for (const f of files) {
    const name = enc.encode(f.name);
    const data = f.data;
    const crc = crc32(data);
    const local = concat([
      u32(0x04034b50), u16(20), u16(0), u16(0), u16(0), u16(0),
      u32(crc), u32(data.length), u32(data.length), u16(name.length), u16(0),
      name, data
    ]);
    locals.push(local);

    const central = concat([
      u32(0x02014b50), u16(20), u16(20), u16(0), u16(0), u16(0), u16(0),
      u32(crc), u32(data.length), u32(data.length), u16(name.length),
      u16(0), u16(0), u16(0), u16(0), u32(0), u32(offset), name
    ]);
    centrals.push(central);
    offset += local.length;
  }
  const centralBlob = concat(centrals);
  const end = concat([
    u32(0x06054b50), u16(0), u16(0), u16(files.length), u16(files.length),
    u32(centralBlob.length), u32(offset), u16(0)
  ]);
  return new Blob([...locals, centralBlob, end], {type:'application/zip'});
}

async function fetchOne(url) {
  const attempts = [
    url,
    'https://corsproxy.io/?url=' + encodeURIComponent(url),
    'https://api.allorigins.win/raw?url=' + encodeURIComponent(url)
  ];
  let lastErr;
  for (const u of attempts) {
    try {
      const r = await fetch(u, {cache:'no-store'});
      if (!r.ok) throw new Error('HTTP ' + r.status);
      const ab = await r.arrayBuffer();
      if (ab.byteLength < 1000) throw new Error('response too small');
      return new Uint8Array(ab);
    } catch (e) {
      lastErr=e;
    }
  }
  throw lastErr || new Error('fetch failed');
}

buildBtn.addEventListener('click', async () => {
  buildBtn.disabled=true;
downloadBtn.disabled=true;
builtZipBlob=null;
  logEl.textContent='';
  const files=[];
  const failed=[];
  let done=0, next=0;

  async function worker() {
    while (true) {
      const i = next++;
      if (i >= URLS.length) return;
      const name = String(i+1).padStart(3,'0') + '.webp';
      try {
        log('Fetching ' + name + ' ...');
        const data = await fetchOne(URLS[i]);
        files.push({name, data, i});
        log('OK      ' + name + ' (' + Math.round(data.length/1024) + ' KB)');
      } catch (e) {
        failed.push({i, error:String(e)});
        log('FAILED  ' + name + '  ' + e);
      } finally {
        done++;
        fill.style.width = (done/URLS.length*100).toFixed(1) + '%';
        statusEl.textContent = `Fetching: ${done}/80  •  OK ${files.length}  •  Failed ${failed.length}`;
      }
    }
  }

  await Promise.all([worker(),worker(),worker(),worker()]);
  files.sort((a,b)=>a.i-b.i);

  const sourceText = URLS.map((u,i)=>`${String(i+1).padStart(3,'0')}.webp\t${u}`).join('\n');
  files.push({name:'source_urls.txt', data:enc.encode(sourceText), i:999});

  if (!files.length) {
    statusEl.textContent='Could not fetch the photos.';
    btn.disabled=false;
    return;
  }

  statusEl.textContent='Building ZIP...';
  builtZipBlob=makeZip(files);
  statusEl.textContent = `BUILT • ${files.length-1} photos zipped` + (failed.length ? ` • ${failed.length} failed` : '');
  log('ZIP built. Click DOWNLOAD ZIP.');
  if (failed.length) log('Failed image numbers: ' + failed.map(x=>x.i+1).join(', '));
  downloadBtn.disabled=false;
  buildBtn.disabled=false;
});

downloadBtn.addEventListener('click', () => {
  if (!builtZipBlob) return;
  const a=document.createElement('a');
  const url=URL.createObjectURL(builtZipBlob);
  a.href=url;
  a.download='10701_Laurel_Vista_Nov_2025_Photos.zip';
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(()=>URL.revokeObjectURL(url),10000);
  statusEl.textContent='DOWNLOAD STARTED';
});
</script>
